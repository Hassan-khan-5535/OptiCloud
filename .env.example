POSTGRES_USER=cindr
POSTGRES_PASSWORD=cindr-local
POSTGRES_DB=cindr
AUTH_SECRET=
DATABASE_URL=postgresql://cindr:cindr-local@localhost:5433/cindr
REDIS_URL=redis://localhost:6380
AWS_REGION=us-east-1
# Set METRICS_PROVIDER=mock only for local demos/tests; production requires a real provider.
METRICS_PROVIDER=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Stage 3 detection engine
UNATTACHED_VOLUME_DAYS=14
IDLE_LOAD_BALANCER_WINDOW_DAYS=7
UNDERUTILIZED_RDS_WINDOW_DAYS=14
UNDERUTILIZED_RDS_MAX_AVG_CONNECTIONS=1
UNDERUTILIZED_RDS_MAX_AVG_CPU_PERCENT=10
DETECTION_SCHEDULE=0 * * * *

# Stage 5 remediation rate limits
AWS_REQUESTS_PER_SECOND=5
GCP_REQUESTS_PER_SECOND=5
