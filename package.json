{
  "name": "cindr",
  "version": "0.1.0",
  "private": true,
  "description": "Cindr FinOps and remediation platform monorepo",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace @cindr/api run dev",
    "dev:web": "npm --workspace @cindr/web run dev",
    "dev:worker": "npm --workspace @cindr/worker run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspace @cindr/worker",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": { "node": ">=20" }
}